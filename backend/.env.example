# Copy to backend/.env and replace the demo connection with your own values.
# URI passwords containing @, :, /, # or % must be URL-encoded.
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/hms_dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required for login (week 2). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Optional access-token lifetime in seconds (default 28800 = 8 hours).
TOKEN_TTL_SECONDS=28800
